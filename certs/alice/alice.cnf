#############################################
# OpenSSL config for Alice1.com
#############################################

[ req ]
default_bits       = 1024
default_md         = sha256
prompt             = no
distinguished_name = req_distinguished_name
req_extensions     = v3_alice_req

[ req_distinguished_name ]
C  = IN
ST = Telangana
L  = Hyderabad
O  = iTS Secure Chat Network
OU = Alice Endpoint Unit
CN = Alice1.com

[ v3_alice_req ]
basicConstraints = CA:FALSE
keyUsage         = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName   = @alt_names_alice

[ alt_names_alice ]
DNS.1 = Alice1.com
DNS.2 = alice1
